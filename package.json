{
  "name": "pi-workbench",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Pi-only workbench harness capabilities",
  "keywords": [
    "pi-package"
  ],
  "bin": {
    "pi-role": "./scripts/pi-role",
    "pi-telemetry": "./scripts/pi-telemetry"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "scripts": {
    "test": "pnpm run test:model-routing && pnpm run test:promote-installed && pnpm run test:background-bash-extension && pnpm run test:secret-redaction-extension && pnpm run test:pi-tmp-extension && pnpm run test:storage-guard-extension && pnpm run test:atelier-extension && pnpm run test:claude-code-atelier && pnpm run test:quota-startup && pnpm run test:lead-fallback && pnpm run test:ponytail-sync-extension && pnpm run test:activity-extension && pnpm run test:telemetry-extension && pnpm run test:subagent-extension && pnpm run test:context-checkpoint-extension && pnpm run test:skill-router && pnpm run test:autonomous-grill-extension && pnpm run test:working-mode-extension && pnpm run test:tool-groups-extension && pnpm run test:agent-audit-extension && pnpm run test:pi-execution-adapter && pnpm run test:worker-registry && pnpm run test:workstream-store && pnpm run test:workstreams-skill && pnpm run test:workstream-session-coordination && pnpm run test:pi-web-integration && pnpm run test:context-usage",
    "test:model-routing": "node skills/model-orchestration/scripts/resolve-runtime-binding.test.mjs",
    "test:background-bash-extension": "node --test extensions/background-bash/*.test.mjs",
    "test:secret-redaction-extension": "node --test extensions/secret-redaction/*.test.mjs",
    "test:pi-tmp-extension": "node --test extensions/pi-tmp/*.test.mjs",
    "test:storage-guard-extension": "node --test extensions/storage-guard/*.test.mjs",
    "test:atelier-extension": "node --test extensions/atelier/*.test.mjs",
    "test:claude-code-atelier": "node --test claude-code/*.test.mjs",
    "test:quota-startup": "node --test extensions/quota-startup/*.test.mjs",
    "test:activity-extension": "node --test extensions/activity/*.test.mjs",
    "test:telemetry-extension": "node --test extensions/telemetry/*.test.mjs",
    "test:subagent-extension": "node --test extensions/subagent/*.test.mjs",
    "test:context-checkpoint-extension": "node --test extensions/context-checkpoint/*.test.mjs",
    "test:skill-router": "node --test scripts/skill-router.test.mjs",
    "test:autonomous-grill-extension": "node --test extensions/autonomous-grill/*.test.mjs",
    "test:working-mode-extension": "node --test extensions/working-mode/*.test.mjs",
    "test:tool-groups-extension": "node --test extensions/tool-groups/*.test.mjs",
    "test:agent-audit-extension": "node --test extensions/agent-audit/*.test.mjs tools/agent-audit/*.test.mjs",
    "test:pi-execution-adapter": "pnpm --dir packages/pi-execution-adapter test",
    "test:worker-registry": "pnpm --dir packages/worker-registry test",
    "test:workstream-store": "pnpm --dir packages/workstream-store test",
    "test:workstreams-skill": "node --test skills/workstreams/scripts/*.test.mjs",
    "test:workstream-session-coordination": "pnpm --dir packages/workstream-session-coordination test",
    "test:pi-web-integration": "pnpm --dir packages/pi-web-integration test",
    "test:promote-installed": "node --test scripts/promote-installed*.test.mjs",
    "test:lead-fallback": "node --test extensions/lead-fallback/*.test.mjs",
    "test:ponytail-sync-extension": "node --test extensions/ponytail-sync/*.test.mjs",
    "test:context-usage": "node --test scripts/context-usage-pi-web.test.mjs"
  },
  "pi": {
    "skills": [
      "./skills"
    ],
    "extensions": [
      "./extensions"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "packageManager": "pnpm@12.21.0"
}
