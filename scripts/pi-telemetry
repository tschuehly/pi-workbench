#!/usr/bin/env node

(async () => {
  const { buildReport, readEvents } = await import("../extensions/telemetry/telemetry.mjs");
  const [command, ...args] = process.argv.slice(2);
  if (command !== "report") throw new Error("Usage: pi-telemetry report [--root-session <id>] [--concept <slug>] [--events-dir <path>]");
  const options = {};
  let directory;
  for (let index = 0; index < args.length; index += 2) {
    const value = args[index + 1];
    if (value === undefined) throw new Error(`Missing value for ${args[index]}.`);
    if (args[index] === "--root-session") options.rootSessionId = value;
    else if (args[index] === "--concept") options.concept = value;
    else if (args[index] === "--events-dir") directory = value;
    else throw new Error(`Unknown option ${args[index]}.`);
  }
  console.log(JSON.stringify(buildReport(await readEvents(directory), options), null, 2));
})().catch((error) => {
  console.error(error.message);
  process.exitCode = 2;
});
