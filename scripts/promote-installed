#!/usr/bin/env bash
# Run Pi Workbench and PI WEB from pinned, immutable builds (docs/contracts/harness.md,
# "Installed and Development Checkouts").
#
#   promote-installed prepare <workbench-rev> <pi-web-rev>
#       Build immutable copies under ~/.pi-workbench/installed. Touches nothing running.
#   promote-installed switch <workbench-rev> <pi-web-rev> [delay-seconds, default 10]
#       Prepare, then schedule a detached launchd job that repoints ~/IdeaProjects/*.installed,
#       the Pi package entry and the PI WEB plugin link, and reinstalls PI WEB's production
#       services. INTERRUPTS EVERY OPEN SESSION. Run only with the owner's go-ahead.
#       Roll back by switching to the previous revisions (the job also restores on failure).
#       Refuses while subagents or workers run, at scheduling and again when the job starts,
#       because the restart kills them. --force (first argument) skips that check.
#   promote-installed switch-workbench <workbench-rev>
#       Prepare, then atomically repoint only ~/IdeaProjects/pi-workbench.installed. PI WEB keeps
#       running; open sessions keep the code they loaded, and new sessions or /reload load the new
#       revision. Use only when the PI WEB plugin code (packages/ used by the server plugin) is
#       unchanged. Roll back by switching to the previous revision, which it prints.
#   promote-installed switch-web <pi-web-rev>
#       Prepare, then restart only PI WEB's web service on the new build and repoint
#       ~/IdeaProjects/pi-web.installed. The session daemon, open sessions and their children keep
#       running; browsers reconnect. Refuses (exit 5) when the code the session daemon loads or the
#       dependency lock differs from its running build; use switch then. Restores the previous web
#       service if it does not become healthy. Prints the command that switches back.
#   promote-installed sessiond-unchanged <pi-web-dir> <pi-web-dir>
#       Exit 0 when both builds give the session daemon the same code, or exit 1 listing the files
#       that differ.
#   promote-installed check-idle
#       Exit 3 and list running child Pi processes, or exit 0 when none run.
#   promote-installed check-settings [settings.json]
#       Exit 6 unless every Pi Workbench or PI WEB package path in Pi's settings, and the PI WEB
#       pi-workbench plugin link, resolves into ~/.pi-workbench/installed (never a development checkout).
set -Eeuo pipefail
export PATH=${PI_PROMOTE_PATH:-/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin}
PROJECTS=${PI_WORKBENCH_PROJECTS:-$HOME/IdeaProjects}
STORE=$HOME/.pi-workbench/installed
PORT=8505 # the Pi Workbench app's default ServerURL

prepare_one() { # <repo-name> <rev> -> prints the prepared directory
  local name=$1 sha dir
  sha=$(git -C "$PROJECTS/$name" rev-parse --verify "$2^{commit}") || return 1
  dir=$STORE/$name-${sha:0:12}
  if [[ ! -e $dir.prepared ]]; then
    [[ -d $dir ]] || git -C "$PROJECTS/$name" worktree add --detach "$dir" "$sha" >&2 || return 1
    # Pi supplies pi-workbench's peer packages at load time; only PI WEB needs installing and building.
    # npm 11 skips node-pty's unapproved install script, which makes spawn-helper executable (Terminal).
    if [[ $name == pi-web ]]; then (cd "$dir" && npm ci --no-audit --no-fund && chmod +x node_modules/node-pty/prebuilds/*/spawn-helper && npm run build) >&2 || return 1; fi
    touch "$dir.prepared" || return 1
  fi
  echo "$dir"
}

check_idle() { # Everything a session starts (subagents, workers, foreground commands, servers) is a
  # child of the session daemon and dies with it. Pi children retitle themselves to plain `pi`, hiding
  # `--mode rpc`. The phone tool's `ping-a-human` helpers restart cleanly, and background bash runners
  # lead their own process group and survive; this script's own ancestors are skipped.
  local busy self=" $$ " p=$$
  while p=$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ') && [[ -n $p && $p -gt 1 ]]; do self+="$p "; done
  busy=$(${PI_PROMOTE_PS:-ps -axo pid=,ppid=,command=} | awk -v self="$self" '
    { line[NR] = $0; pid[NR] = $1; parent[NR] = $2; cmd = $0; sub(/^ *[0-9]+ +[0-9]+ +/, "", cmd); command[NR] = cmd
      if (cmd ~ /sessiond[.]js/) daemon[$1] = 1 }
    END { for (i = 1; i <= NR; i++) {
      if (index(self, " " pid[i] " ")) continue
      if (command[i] ~ / --mode[ ]rpc( |$)/ || (daemon[parent[i]] && command[i] !~ /ping-a-human|<defunct>|background-bash\/runner[.]mjs/)) print line[i] } }')
  [[ -z $busy ]] && return 0
  echo "refusing: a restart would kill these subagents, workers, and commands:" >&2
  echo "$busy" | cut -c1-160 >&2
  return 3
}

check_settings() { # [settings.json]
  node -e '
    const fs=require("fs"),path=require("path"),[file,store,plugin]=process.argv.slice(1);
    const real=p=>{try{return fs.realpathSync(p)}catch{return null}},root=(real(store)??store)+"/";
    const paths=(JSON.parse(fs.readFileSync(file,"utf8")).packages??[]).map(p=>typeof p==="string"?p:p.source)
      .filter(p=>/^[~/.]/.test(p)&&/pi-web|pi-workbench/.test(p))
      .map(p=>path.resolve(path.dirname(file),p.replace(/^~(?=\/)/,process.env.HOME)));
    try{fs.lstatSync(plugin);paths.push(plugin)}catch{}
    const bad=paths.filter(p=>!real(p)?.startsWith(root));
    for(const p of bad)console.error(`not an installed checkout: ${p} -> ${real(p)??"missing"}`);
    process.exit(bad.length?6:0)' "${1:-$HOME/.pi/agent/settings.json}" "$STORE" "$HOME/.pi-web/plugins/pi-workbench"
}

healthy() {
  curl -fsS --max-time 3 http://127.0.0.1:$PORT/api/plugins 2>/dev/null | node -e '
    let d="";process.stdin.on("data",c=>d+=c).on("end",()=>{const p=JSON.parse(d).plugins.find(x=>x.id==="pi-workbench");
    process.exit(p&&p.server&&p.server.state==="active"&&!p.server.restartRequired?0:1)})' 2>/dev/null
}

sessiond_unchanged() { # <pi-web-dir> <pi-web-dir>: same relative-import closure of the daemon entry and same lock
  # ponytail: static import scan only; a computed import("./" + x) would slip past, add a bundler metafile then.
  node - "$1" "$2" <<'JS'
const fs = require("fs"), path = require("path"), { createHash } = require("crypto");
const hash = (root, file) => { try { return createHash("sha256").update(fs.readFileSync(path.join(root, file))).digest("hex"); } catch { return "missing"; } };
const closure = (root) => {
  const seen = new Map([["package-lock.json", hash(root, "package-lock.json")]]), todo = ["dist/server/sessiond.js"];
  while (todo.length) {
    const file = todo.pop();
    if (seen.has(file)) continue;
    seen.set(file, hash(root, file));
    if (seen.get(file) === "missing") continue;
    for (const [, spec] of fs.readFileSync(path.join(root, file), "utf8").matchAll(/\b(?:from|import)\s*\(?\s*["'](\.\.?\/[^"']+)["']/g))
      todo.push(path.join(path.dirname(file), spec));
  }
  return seen;
};
const [a, b] = process.argv.slice(-2).map(closure);
const changed = [...new Set([...a.keys(), ...b.keys()])].filter((file) => a.get(file) !== b.get(file));
for (const file of changed) console.error(`  ${file}`);
process.exit(changed.length ? 1 : 0);
JS
}

force=0; [[ ${1:-} == --force ]] && { force=1; shift; }
[[ ${1:-} == check-idle ]] && { check_idle; exit $?; }
[[ ${1:-} == check-settings && $# -le 2 ]] && { check_settings "${2:-}"; exit $?; }
[[ ${1:-} == sessiond-unchanged && $# -eq 3 ]] && { sessiond_unchanged "$2" "$3"; exit $?; }
if [[ ${1:-} == switch-web && $# -eq 2 ]]; then
  la=$HOME/Library/LaunchAgents; web=$HOME/Library/LaunchAgents/com.pi-web.web.plist
  entry() { sed -e "s/&apos;/'/g" "$1" | sed -n "s|.*exec node '\(.*\)/dist/server/$2'.*|\1|p"; }
  running=$(entry "$la/com.pi-web.sessiond.plist" sessiond.js); old=$(entry "$web" index.js)
  [[ -n $running && -n $old ]] || { echo "cannot read the running PI WEB builds from $la" >&2; exit 1; }
  mkdir -p "$STORE"
  pw=$(prepare_one pi-web "$2") || { echo "prepare pi-web failed" >&2; exit 1; }
  if ! sessiond_unchanged "$running" "$pw"; then
    echo "refusing: the files above differ from the running session daemon ($running); use switch" >&2; exit 5
  fi
  swap() { # <from-dir> <to-dir>
    sed -i '' "s|$1/dist/server/index.js|$2/dist/server/index.js|" "$web"
    ln -sfn "$2" "$PROJECTS/pi-web.installed"
    launchctl bootout "gui/$(id -u)/com.pi-web.web" 2>/dev/null || true
    sleep 1
    launchctl bootstrap "gui/$(id -u)" "$web"
  }
  up() { for _ in $(seq 60); do healthy && return 0; sleep 1; done; return 1; }
  swap "$old" "$pw"
  if up; then echo "web: $old -> $pw" | tee -a "$STORE/switch-web.log"; echo "roll back: $0 switch-web ${old##*-}"; exit 0; fi
  echo "FAILED; restoring $old" >&2
  swap "$pw" "$old"
  up && exit 1
  echo "ROLLBACK FAILED: web service unhealthy on $old" >&2; exit 4
fi
if [[ ${1:-} == switch-workbench && $# -eq 2 ]]; then
  check_settings || { echo "refusing: Pi would not load the promoted Pi Workbench; fix the paths above" >&2; exit 6; }
  mkdir -p "$STORE"
  wb=$(prepare_one pi-workbench "$2") || { echo "prepare pi-workbench failed" >&2; exit 1; }
  link=$PROJECTS/pi-workbench.installed
  previous=$(readlink "$link" || true)
  python3 -c 'import os,sys; t,l=sys.argv[1:]; os.symlink(t,l+".new"); os.replace(l+".new",l)' "$wb" "$link"
  echo "pi-workbench.installed: ${previous:-none} -> $wb" | tee -a "$STORE/switch-workbench.log"
  echo "roll back: $0 switch-workbench ${previous##*-}"
  exit 0
fi
[[ $# -ge 3 && ($1 == prepare || $1 == switch) ]] || { sed -n '2,32p' "$0"; exit 2; }
if [[ $1 == switch && $force == 0 ]]; then check_idle || exit 3; fi
mkdir -p "$STORE"
wb=$(prepare_one pi-workbench "$2") || { echo "prepare pi-workbench failed" >&2; exit 1; }
pw=$(prepare_one pi-web "$3") || { echo "prepare pi-web failed" >&2; exit 1; }
echo "prepared: $wb"
echo "prepared: $pw"
[[ $1 == switch ]] || exit 0

uid=$(id -u)
self=$(cd "$(dirname "$0")" && pwd -P)/$(basename "$0")
job=$STORE/jobs/$(date -u +%Y%m%dT%H%M%SZ)
label=com.pi-workbench.promote-installed.$(basename "$job")
mkdir -p "$job/backup"
cat >"$job/job.sh" <<EOF
#!/bin/bash
set -Euo pipefail
export PATH=$PATH
exec >>"$job/job.log" 2>&1
trap 'launchctl bootout gui/$uid/$label' EXIT
sleep ${4:-10}
if [[ $force == 0 ]] && ! "$self" check-idle; then echo "refused \$(date -u +%FT%TZ): subagents started during the delay; nothing changed"; exit 3; fi
echo "start \$(date -u +%FT%TZ) wb=$wb pw=$pw"
la=\$HOME/Library/LaunchAgents
cp -p \$la/com.pi-web.*.plist \$HOME/.pi/agent/settings.json \$HOME/.config/pi-web/config.json "$job/backup/" || { echo "backup failed"; exit 1; }
for l in pi-workbench.installed pi-web.installed; do readlink "$PROJECTS/\$l" >>"$job/backup/links" || echo >>"$job/backup/links"; done
readlink \$HOME/.pi-web/plugins/pi-workbench >"$job/backup/plugin-link"

stop_all() {
  for s in ui-dev web sessiond; do launchctl bootout gui/$uid/com.pi-web.\$s 2>/dev/null || true; done
  sleep 3
  # Dev launchers can orphan children (ISSUE-032): stop leftovers that still hold PI WEB's ports or socket.
  for p in \$(lsof -ti tcp:8504 -sTCP:LISTEN; lsof -ti tcp:8505 -sTCP:LISTEN; lsof -t \$HOME/.pi-web/sessiond.sock); do
    kill -TERM "\$p" 2>/dev/null || true
  done 2>/dev/null
  sleep 3
}
PORT=$PORT
$(declare -f healthy)
rollback() {
  echo "FAILED; restoring previous services"
  stop_all
  {
    rm -f \$la/com.pi-web.*.plist &&
    cp -p "$job"/backup/com.pi-web.*.plist \$la/ &&
    cp -p "$job/backup/settings.json" \$HOME/.pi/agent/settings.json &&
    cp -p "$job/backup/config.json" \$HOME/.config/pi-web/config.json &&
    ln -sfn "\$(cat "$job/backup/plugin-link")" \$HOME/.pi-web/plugins/pi-workbench
  } || { echo "ROLLBACK FAILED: restoring saved files"; exit 4; }
  i=0; for l in pi-workbench.installed pi-web.installed; do
    i=\$((i+1)); t=\$(sed -n "\${i}p" "$job/backup/links")
    if [[ -n \$t ]]; then ln -sfn "\$t" "$PROJECTS/\$l" || { echo "ROLLBACK FAILED: restoring \$l"; exit 4; }
    else rm -f "$PROJECTS/\$l" || { echo "ROLLBACK FAILED: removing \$l"; exit 4; }; fi
  done
  boot_failed=0
  for f in \$la/com.pi-web.*.plist; do launchctl bootstrap gui/$uid "\$f" || boot_failed=1; done
  if [[ \$boot_failed == 1 ]]; then echo "ROLLBACK FAILED: old service bootstrap"; exit 4; fi
  for i in \$(seq 90); do
    if healthy; then echo "rollback done \$(date -u +%FT%TZ)"; exit 1; fi
    sleep 1
  done
  echo "ROLLBACK FAILED: old service health check"
  exit 4
}

ln -sfn "$wb" "$PROJECTS/pi-workbench.installed"
ln -sfn "$pw" "$PROJECTS/pi-web.installed"
ln -sfn "$PROJECTS/pi-workbench.installed/packages" \$HOME/.pi-web/plugins/pi-workbench
node -e '
  const fs=require("fs"),[f,from,to]=process.argv.slice(1),s=JSON.parse(fs.readFileSync(f,"utf8"));
  const [wbFrom,wbTo,pw]=[from,to,process.argv[4]];
  s.packages=s.packages.map(p=>typeof p!=="string"?p:p===wbFrom?wbTo
    :p.replace(/^.*\/pi-web[^/]*\/dist\/pi-packages\//,pw+"/dist/pi-packages/"));
  fs.writeFileSync(f,JSON.stringify(s,null,2)+"\n")' \
  \$HOME/.pi/agent/settings.json "$PROJECTS/pi-workbench" "$PROJECTS/pi-workbench.installed" "$PROJECTS/pi-web.installed"
"$self" check-settings || rollback
node -e '
  const fs=require("fs"),f=process.argv[1],c=JSON.parse(fs.readFileSync(f,"utf8"));
  c.port=$PORT; fs.writeFileSync(f,JSON.stringify(c,null,2)+"\n")' \$HOME/.config/pi-web/config.json
stop_all
(cd "$pw" && "${PI_PROMOTE_ZSH:-/bin/zsh}" -lc 'node dist/cli.js install') || rollback
for i in \$(seq 90); do healthy && { echo "promoted \$(date -u +%FT%TZ)"; exit 0; }; sleep 1; done
rollback
EOF
chmod +x "$job/job.sh"
plutil -create xml1 "$job/job.plist"
plutil -insert Label -string "$label" "$job/job.plist"
plutil -insert ProgramArguments -array "$job/job.plist"
plutil -insert ProgramArguments.0 -string "$job/job.sh" "$job/job.plist"
plutil -insert RunAtLoad -bool true "$job/job.plist"
launchctl bootstrap "gui/$uid" "$job/job.plist"
echo "scheduled $label in ${4:-10}s; log: $job/job.log"
