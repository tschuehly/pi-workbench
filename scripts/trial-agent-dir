#!/usr/bin/env bash
# Usage: trial-agent-dir <dir>   → prints <dir>, ready to use as PI_CODING_AGENT_DIR for a trial PI WEB instance.
#
# A trial's session daemon writes to its agent profile's settings.json at start (PI WEB's bundled
# package auto-install adds its own dist/pi-packages paths). Pointed at the real ~/.pi/agent, that
# breaks `promote-installed check-settings` for every install. This overlay links every entry of the
# real profile (auth, sessions, extensions, MCP, …) but gives the trial its own copy of settings.json.
# ponytail: only settings.json is isolated; other writes (sessions, caches) still reach the real profile.
set -euo pipefail
dir=${1:?usage: trial-agent-dir <dir>}
real=${PI_REAL_AGENT_DIR:-$HOME/.pi/agent}
[[ $(cd "$real" && pwd -P) != $(mkdir -p "$dir" && cd "$dir" && pwd -P) ]] || { echo "refusing: $dir is the real agent profile" >&2; exit 1; }
for entry in "$real"/* "$real"/.[!.]*; do
  [[ -e $entry ]] || continue
  name=$(basename "$entry")
  [[ $name == settings.json* ]] && continue
  ln -sfn "$entry" "$dir/$name"
done
[[ -f $dir/settings.json && ! -L $dir/settings.json ]] || { rm -f "$dir/settings.json"; cp -p "$real/settings.json" "$dir/settings.json"; }
chmod 700 "$dir"
echo "$dir"
