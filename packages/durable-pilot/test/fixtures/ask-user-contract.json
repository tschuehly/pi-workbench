{
  "note": "ask_user question rules contract, kept byte-identical in two repos: pi-workbench packages/durable-pilot/test/fixtures/ask-user-contract.json (host copy: src/workbench.ts toQuestion/validateQuestions) and pi-web src/server/sessions/askUserContract.fixture.json (copies: askUserTool.ts toQuestion/toOption, pendingAskStore.ts validateQuestion/validateOption). A field added to one copy must be added to the others and here.",
  "valid": {
    "input": {
      "context": "**Context** shared by every question.",
      "questions": [
        {
          "id": "db",
          "question": "1. Which database?",
          "detail": "Markdown detail of db.",
          "options": [
            { "value": "pg", "label": "Postgres", "detail": "One store.", "recommended": true, "unknownOptionField": "dropped" },
            { "value": "sqlite", "label": "SQLite", "recommended": false }
          ],
          "multiple": false,
          "unknownQuestionField": "dropped"
        },
        {
          "id": "features",
          "question": "Which features?",
          "detail": "Pick any.",
          "options": [
            { "value": "a", "label": "A" },
            { "value": "b", "label": "B" }
          ],
          "multiple": true,
          "showIf": { "question": "db", "values": ["pg", "sqlite", "pg"], "unknownShowIfField": "dropped" }
        },
        {
          "id": "why",
          "question": "3) Why?",
          "detail": "Free text only."
        }
      ]
    },
    "expected": {
      "context": "**Context** shared by every question.",
      "questions": [
        {
          "id": "db",
          "question": "Which database?",
          "detail": "Markdown detail of db.",
          "options": [
            { "value": "pg", "label": "Postgres", "detail": "One store.", "recommended": true },
            { "value": "sqlite", "label": "SQLite" }
          ]
        },
        {
          "id": "features",
          "question": "Which features?",
          "detail": "Pick any.",
          "options": [
            { "value": "a", "label": "A" },
            { "value": "b", "label": "B" }
          ],
          "multiple": true,
          "showIf": { "question": "db", "values": ["pg", "sqlite"] }
        },
        {
          "id": "why",
          "question": "Why?",
          "detail": "Free text only.",
          "options": []
        }
      ]
    }
  },
  "invalid": [
    {
      "name": "showIf names a later question",
      "questions": [
        { "id": "first", "question": "First?", "detail": "d", "showIf": { "question": "second", "values": ["y"] } },
        { "id": "second", "question": "Second?", "detail": "d", "options": [{ "value": "y", "label": "Yes" }] }
      ],
      "error": "showIf of question first must name an earlier question of this set, not second"
    },
    {
      "name": "showIf names a value the earlier question does not offer",
      "questions": [
        { "id": "first", "question": "First?", "detail": "d", "options": [{ "value": "y", "label": "Yes" }] },
        { "id": "second", "question": "Second?", "detail": "d", "showIf": { "question": "first", "values": ["n"] } }
      ],
      "error": "showIf of question second: question first has no option n"
    },
    {
      "name": "duplicate option value",
      "questions": [
        { "id": "q", "question": "Pick?", "detail": "d", "options": [{ "value": "a", "label": "A" }, { "value": "a", "label": "Again" }] }
      ],
      "error": "Duplicate option value a in question q"
    },
    {
      "name": "duplicate question id",
      "questions": [
        { "id": "same", "question": "First?", "detail": "d" },
        { "id": "same", "question": "Second?", "detail": "d" }
      ],
      "error": "Duplicate question id same"
    },
    {
      "name": "blank question text",
      "questions": [
        { "id": "q", "question": "  ", "detail": "d" }
      ],
      "error": "text of question q must not be empty"
    }
  ]
}
