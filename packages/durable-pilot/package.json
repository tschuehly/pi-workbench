{
  "name": "@pi-workbench/durable-pilot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@earendil-works/chord": "1.6.0",
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-codemode": "1.6.0",
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@earendil-works/pi-durable": "1.6.0",
    "@earendil-works/pi-schema": "1.6.0",
    "@earendil-works/pi-telemetry": "1.6.0",
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/proper-lockfile": "4.1.4",
    "playwright": "1.61.1",
    "typescript": "7.0.2"
  },
  "scripts": {
    "setup": "pnpm install --frozen-lockfile --ignore-scripts && pnpm --dir legacy-1.3 install --frozen-lockfile --ignore-scripts",
    "typecheck": "tsc -p .",
    "test:matrix": "node --test --test-concurrency=1 --test-timeout=1800000 test/generation-tools.test.ts test/children-queue-questions.test.ts test/ownership-storage.test.ts test/credentials.test.ts",
    "test:upgrade": "node --test --test-concurrency=1 --test-timeout=1800000 test/upgrade-restart.test.ts",
    "test:spikes": "node --test --test-concurrency=1 test/redaction.test.ts test/redaction-split.test.ts test/redaction-boundaries.test.ts test/claude.test.ts test/providers.test.ts",
    "test": "pnpm run typecheck && pnpm run test:matrix && pnpm run test:upgrade && pnpm run test:spikes && pnpm run test:chat && pnpm run test:extensions && pnpm run test:packages && pnpm run test:bash-atelier && pnpm run summary",
    "summary": "node scripts/summary.ts",
    "latency": "node scripts/commit-latency.ts",
    "baseline:queue-order": "node scripts/queue-order-baseline.ts",
    "spike:claude:live": "PILOT_LIVE_CLAUDE=1 node scripts/claude-subscription-spike.ts",
    "test:chat": "node --test --test-concurrency=1 --test-timeout=150000 test/chat-host.test.ts test/backup.test.ts test/host-socket.test.ts test/composer.test.ts test/context-tools.test.ts test/tree.test.ts test/delegation.test.ts test/codemode-spawn.test.ts test/chat-message.test.ts test/tool-redefinition.test.ts test/ask-user-contract.test.ts test/idle-compact.test.ts",
    "test:extensions": "node --test --test-concurrency=1 --test-timeout=120000 test/extensions-host.test.ts",
    "chat-host": "node src/chat-host-main.ts",
    "test:packages": "node --test --test-concurrency=1 --test-timeout=120000 test/packages.test.ts test/paused-reads.test.ts test/paused-actions.test.ts",
    "test:bash-atelier": "node --test --test-concurrency=1 --test-timeout=120000 test/background-bash.test.ts test/child-deadlines.test.ts test/atelier.test.ts test/cheap-wake.test.ts"
  },
  "packageManager": "pnpm@12.21.0"
}
