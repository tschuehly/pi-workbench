{
  "name": "@pi-workbench/durable-pilot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-codemode": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "@earendil-works/pi-telemetry": "1.4.0",
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/proper-lockfile": "4.1.4",
    "typescript": "7.0.2"
  },
  "scripts": {
    "setup": "npm ci --ignore-scripts && npm ci --ignore-scripts --prefix legacy-1.3",
    "typecheck": "tsc -p .",
    "test:matrix": "node --test --test-concurrency=1 --test-timeout=1800000 test/generation-tools.test.ts test/children-queue-questions.test.ts test/ownership-storage.test.ts test/credentials.test.ts",
    "test:spikes": "node --test --test-concurrency=1 test/redaction.test.ts test/claude.test.ts",
    "test": "npm run typecheck && npm run test:matrix && npm run test:spikes && npm run test:chat && npm run summary",
    "summary": "node scripts/summary.ts",
    "latency": "node scripts/commit-latency.ts",
    "baseline:queue-order": "node scripts/queue-order-baseline.ts",
    "spike:claude:live": "PILOT_LIVE_CLAUDE=1 node scripts/claude-subscription-spike.ts",
    "test:chat": "node --test --test-concurrency=1 --test-timeout=120000 test/chat-host.test.ts",
    "chat-host": "node src/chat-host-main.ts"
  }
}
